{
  "name": "ical-filter",
  "private": true,
  "description": "iCalendar filtering service, primarily targetted at Microsoft Office public feeds",
  "cloudflare": {
    "products": [
      "Workers"
    ]
  },
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.33.0",
    "jest": "^29.0.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "wrangler": "^4.51.0"
  }
}
